{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/LSix",
      "destination": "/LSix/",
      "permanent": true
    }
  ],
  "images": {
    "sizes": [
      256,
      1080
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "firebasestorage.googleapis.com",
        "pathname": "/v0/b/scanmonitor-sg.appspot.com/**"
      }
    ]
  }
}
